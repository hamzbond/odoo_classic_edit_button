<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Extend FormView: Replace control-panel-create-button with Edit/Save/Cancel/New -->
    <t t-name="form_edit_mode.FormView" t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']/button[hasclass('o_form_button_create')]" position="replace">
            
            <!-- Tampilkan Save dan Cancel asalkan sedang dalam mode Edit (baik record baru maupun lama) -->
            <t t-if="model.root.isInEdition">
                <button type="button" class="btn btn-primary o_form_button_save_edit" t-on-click.stop="() => this.saveButtonClicked({closable: true})"> Save </button>
                <button type="button" class="btn btn-secondary o_form_button_cancel_edit ms-1" t-on-click.stop="discard"> Discard </button>
            </t>
            
            <!-- Tampilkan Edit HANYA jika bukan record baru (karena record baru otomatis mode edit) -->
            <t t-elif="canEdit and !model.root.isNew">
                <button type="button" class="btn btn-primary o_form_button_edit_mode" t-on-click.stop="editRecord"> Edit </button>
            </t>
            
            <!-- Tampilkan New HANYA saat tidak sedang mode edit -->
            <button t-if="canCreate and !model.root.isInEdition" type="button" class="btn btn-outline-primary o_form_button_create ms-1" data-hotkey="c" t-on-click.stop="create">New</button>
        </xpath>
    </t>

    <!-- Dialog footer: Tidak ada masalah di sini, tetap pertahankan -->
    <t t-name="form_edit_mode.FormViewButtons" t-inherit="web.FormView.Buttons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_form_button_create')]" position="replace">
            <button t-if="canEdit and !model.root.isNew and !model.root.isInEdition" type="button" class="btn btn-primary o_form_button_edit_mode" t-on-click.stop="editRecord"> Edit </button>
            <button t-if="!model.root.isInEdition and canCreate" type="button" class="btn btn-secondary o_form_button_create" data-hotkey="c" t-on-click.stop="create"> New </button>
        </xpath>
    </t>
</templates>